    "instructions": {
      "_type": "localizedPortableText",
      "de": [
        {
          "_key": "93d6af210587",
          "_type": "block",
          "children": [
            {
              "_key": "3de0a84e998d",
              "_type": "span",
              "marks": [],
              "text": ""
            }
          ],
          "markDefs": [],
          "style": "normal"
        },
        {
          "_key": "847370b8acf5",
          "_type": "block",
          "children": [
            {
              "_key": "e2f7f1f1cd19",
              "_type": "span",
              "marks": [],
              "text": "und Hefe vermischen."
            }
          ],
          "level": 1,
          "listItem": "number",
          "markDefs": [],
          "style": "normal"
        },
        {
          "_key": "640c5236ff13",
          "_type": "block",
          "children": [
            {
              "_key": "0f1b672f579e",
              "_type": "span",
              "marks": [],
              "text": "Den Teig in einer Teigmaschine kneten. Sobald er zusammenkommt, Butter hinzufügen und weiterkneten, bis er glatt ist."
            }
          ],
          "level": 1,
          "listItem": "number",
          "markDefs": [],
          "style": "normal"
        },
        {
          "_key": "04fea5a6deae",
          "_type": "block",
          "children": [
            {
              "_key": "6b3e00adbc02",
              "_type": "span",
              "marks": [],
              "text": "Den Teig abgedeckt etwa 50 Minuten an einem warmen Ort gehen lassen."
            }
          ],
          "level": 1,
          "listItem": "number",
          "markDefs": [],
          "style": "normal"
        },
        {
          "_key": "301a48c8a131",
          "_type": "block",
          "children": [
            {
              "_key": "d7e51f349773",
              "_type": "span",
              "marks": [],
              "text": "In der Zwischenzeit die Soboro-Keksmischung vorbereiten."
            }
          ],
          "level": 1,
          "listItem": "number",
          "markDefs": [],
          "style": "normal"
        },
        {
          "_key": "5fdb5094b4a8",
          "_type": "block",
          "children": [
            {
              "_key": "1e02facc08a8",
              "_type": "span",
              "marks": [],
              "text": "Nach der ersten Gärung den Teig entgasen und in 8 Stücke teilen. Diese abgedeckt etwa 10 Minuten ruhen lassen."
            }
          ],
          "level": 1,
          "listItem": "number",
          "markDefs": [],
          "style": "normal"
        },
        {
          "_key": "f6e6e0e15240",
          "_type": "block",
          "children": [
            {
              "_key": "7b7e410802be",
              "_type": "span",
              "marks": [],
              "text": "Die Teigstücke flach ausrollen und mit den Händen leicht zusammendrücken."
            }
          ],
          "level": 1,
          "listItem": "number",
          "markDefs": [],
          "style": "normal"
        },
        {
          "_key": "4bdeaa3f79dc",
          "_type": "block",
          "children": [
            {
              "_key": "5c1ac8560a0b",
              "_type": "span",
              "marks": [],
              "text": "Die Soboro-Mischung auf den Brotteig geben und leicht in die Mitte drücken."
            }
          ],
          "level": 1,
          "listItem": "number",
          "markDefs": [],
          "style": "normal"
        },
        {
          "_key": "411cf852ef14",
          "_type": "block",
          "children": [
            {
              "_key": "c023c5d91aa8",
              "_type": "span",
              "marks": [],
              "text": "Den Teig auf ein Backblech legen und nochmals 45 Minuten gehen lassen."
            }
          ],
          "level": 1,
          "listItem": "number",
          "markDefs": [],
          "style": "normal"
        },
        {
          "_key": "8b584082301d",
          "_type": "block",
          "children": [
            {
              "_key": "0bc3b549a7c5",
              "_type": "span",
              "marks": [],
              "text": "Den Ofen auf 190 Grad vorheizen und die Brote etwa 10 Minuten backen."
            }
          ],
          "level": 1,
          "listItem": "number",
          "markDefs": [],
          "style": "normal"
        },
        {
          "_key": "34a4975b1d02",
          "_type": "block",
          "children": [
            {
              "_key": "24695068ecd4",
              "_type": "span",
              "marks": [],
              "text": "Soboro-Brot ist fertig!"
            }
          ],
          "level": 1,
          "listItem": "number",
          "markDefs": [],
          "style": "normal"
        },
        {
          "_key": "2f916520a306",
          "_type": "block",
          "children": [
            {
              "_key": "72db6eb1033f",
              "_type": "span",
              "marks": [],
              "text": ""
            }
          ],
          "markDefs": [],
          "style": "normal"
        }
      ],
      "en": [
        {
          "_key": "2b223eedf011",
          "_type": "block",
          "children": [
            {
              "_key": "424299c4872e",
              "_type": "span",
              "marks": [],
              "text": "Mix the bread dough in a bowl with lukewarm milk, egg, flour, sugar, salt, and yeast."
            }
          ],
          "level": 1,
          "listItem": "number",
          "markDefs": [],
          "style": "normal"
        },
        {
          "_key": "7ef2f357ebc8",
          "_type": "block",
          "children": [
            {
              "_key": "11737509fd3b",
              "_type": "span",
              "marks": [],
              "text": "Knead the dough in a stand mixer. Once it comes together, add butter and continue kneading until smooth."
            }
          ],
          "level": 1,
          "listItem": "number",
          "markDefs": [],
          "style": "normal"
        },
        {
          "_key": "3f5eadb4b2cd",
          "_type": "block",
          "children": [
            {
              "_key": "b06593da6b37",
              "_type": "span",
              "marks": [],
              "text": "Cover the dough and let it rise in a warm place for about 50 minutes."
            }
          ],
          "level": 1,
          "listItem": "number",
          "markDefs": [],
          "style": "normal"
        },
        {
          "_key": "daaf20a642a7",
          "_type": "block",
          "children": [
            {
              "_key": "1a3e265b99c5",
              "_type": "span",
              "marks": [],
              "text": "In the meantime, prepare the Soboro cookie mixture."
            }
          ],
          "level": 1,
          "listItem": "number",
          "markDefs": [],
          "style": "normal"
        },
        {
          "_key": "b5bc7ddc25e0",
          "_type": "block",
          "children": [
            {
              "_key": "99dd218436c6",
              "_type": "span",
              "marks": [],
              "text": "After the first proofing, punch down the dough to release air and divide it into 8 pieces. Cover and let them rest for about 10 minutes."
            }
          ],
          "level": 1,
          "listItem": "number",
          "markDefs": [],
          "style": "normal"
        },
        {
          "_key": "3e6a4d06bfe8",
          "_type": "block",
          "children": [
            {
              "_key": "7de4f6fe0ccc",
              "_type": "span",
              "marks": [],
              "text": "Roll out each piece of dough and gently press it together with your hands."
            }
          ],
          "level": 1,
          "listItem": "number",
          "markDefs": [],
          "style": "normal"
        },
        {
          "_key": "43794814e53e",
          "_type": "block",
          "children": [
            {
              "_key": "7fdec6e34243",
              "_type": "span",
              "marks": [],
              "text": "Place the Soboro mixture on top of the bread dough and gently press it into the center."
            }
          ],
          "level": 1,
          "listItem": "number",
          "markDefs": [],
          "style": "normal"
        },
        {
          "_key": "c839ba6a607c",
          "_type": "block",
          "children": [
            {
              "_key": "453f2c3b7b9e",
              "_type": "span",
              "marks": [],
              "text": "Place the dough pieces on a baking sheet and let them rise again for 45 minutes."
            }
          ],
          "level": 1,
          "listItem": "number",
          "markDefs": [],
          "style": "normal"
        },
        {
          "_key": "b7702eb52315",
          "_type": "block",
          "children": [
            {
              "_key": "e4c7b21d6ea0",
              "_type": "span",
              "marks": [],
              "text": "Preheat the oven to 190°C and bake the bread for about 10 minutes."
            }
          ],
          "level": 1,
          "listItem": "number",
          "markDefs": [],
          "style": "normal"
        },
        {
          "_key": "a48cedb882be",
          "_type": "block",
          "children": [
            {
              "_key": "81170d806105",
              "_type": "span",
              "marks": [],
              "text": "Soboro bread is ready!"
            }
          ],
          "level": 1,
          "listItem": "number",
          "markDefs": [],
          "style": "normal"
        },
        {
          "_key": "fb7cd2cd97ff",
          "_type": "block",
          "children": [
            {
              "_key": "30909b296b68",
              "_type": "span",
              "marks": [],
              "text": "\n"
            }
          ],
